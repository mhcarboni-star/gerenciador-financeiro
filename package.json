{
  "name": "gerenciador-financeiro",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace api & npm run dev --workspace web",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace api",
    "start": "npm run start --workspace api",
    "db:migrate": "npm run db:migrate --workspace api",
    "typecheck": "npm run typecheck --workspaces",
    "db:deploy": "npm run db:deploy --workspace api"
  },
  "engines": {
    "node": ">=20"
  }
}
