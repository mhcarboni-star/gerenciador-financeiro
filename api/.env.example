# Local: as duas URLs podem ser iguais.
# Supabase (botão "Connect" no projeto):
#   DATABASE_URL = "Transaction pooler" (porta 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = "Session pooler" (porta 5432)
DATABASE_URL="postgresql://gf:gf@localhost:5432/gerenciador"
DIRECT_URL="postgresql://gf:gf@localhost:5432/gerenciador"
JWT_SECRET="troque-por-um-valor-longo-e-aleatorio"
PORT=3333

# Avisos no celular (opcional em desenvolvimento): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@example.com"
JOB_SECRET="troque-por-um-valor-aleatorio"
