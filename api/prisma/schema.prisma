// Estrutura do banco do Gerenciador Financeiro.
// Documentação completa: docs/banco-de-dados.md
//
// Convenções:
// - Valores monetários em centavos (Int), sempre positivos; o sentido vem do tipo do lançamento.
// - Tudo que é dado financeiro pertence a um Grupo (Household), nunca direto a um usuário,
//   para permitir uso compartilhado (casal/família).
// - Datas sem hora usam @db.Date. Meses de referência são guardados como o dia 1 do mês.
// - "Arquivar" (archivedAt) em vez de excluir, para não quebrar o histórico.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // No Supabase: DATABASE_URL = conexão via pooler (porta 6543, ?pgbouncer=true)
  //              DIRECT_URL   = conexão direta (porta 5432), usada pelas migrações
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum MemberRole {
  OWNER // pode convidar/remover membros e excluir o grupo
  MEMBER
}

enum AccountType {
  CHECKING // conta corrente
  SAVINGS // poupança
  CASH // carteira / dinheiro
  INVESTMENT
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME // entrada em uma conta (ou estorno no cartão)
  EXPENSE // saída de uma conta ou compra no cartão
  TRANSFER // conta → conta (não entra em receitas/despesas)
  INVOICE_PAYMENT // pagamento de fatura: conta → cartão (não é despesa; as compras já foram)
  LOAN_RECEIPT // dinheiro do empréstimo entrando na conta (não é receita)
  LOAN_PAYMENT // pagamento de empréstimo: amortização + juros
  ADJUSTMENT_IN // ajuste de saldo para mais (não é receita)
  ADJUSTMENT_OUT // ajuste de saldo para menos (não é despesa)
}

enum LoanInterestType {
  NONE // sem juros: saldo = valor emprestado − amortizações
  PRICE // parcelas fixas com juros compostos (Tabela Price): bancos, consignado, financiamentos
  MONTHLY_ON_BALANCE // juros mensais compostos sobre o saldo devedor, pagamentos livres
}

enum LoanStatus {
  ACTIVE
  PAID_OFF // quitado
  CANCELLED
}

enum TransactionStatus {
  PENDING // previsto / a pagar / a receber
  PAID // efetivado
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
}

enum NotificationKind {
  DUE_ITEMS // contas/recebimentos previstos para hoje + atrasados
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// ─────────────────────── Usuários e grupos ───────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships         HouseholdMember[]
  invitesSent         HouseholdInvite[] @relation("InviteSender")
  transactionsCreated Transaction[]     @relation("TransactionCreator")
  accountsOwned       Account[]         @relation("AccountOwner")
  cardsHeld           CreditCard[]      @relation("CardHolder")

  pushSubscriptions    PushSubscription[]
  notificationSettings NotificationSettings?
  notificationLogs     NotificationLog[]
}

/// Grupo financeiro (ex.: "Casa"). Todos os dados financeiros pertencem a um grupo.
model Household {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("BRL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          HouseholdMember[]
  invites          HouseholdInvite[]
  accounts         Account[]
  creditCards      CreditCard[]
  categories       Category[]
  transactions     Transaction[]
  installmentPlans InstallmentPlan[]
  recurrences      Recurrence[]
  budgets          Budget[]
  goals            Goal[]
  loans            Loan[]
  monthPlans       MonthPlan[]
}

model HouseholdMember {
  householdId    String
  userId         String
  role           MemberRole @default(MEMBER)
  /// receber avisos das contas do dia deste grupo
  notifyDueItems Boolean    @default(true)
  joinedAt       DateTime   @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
  @@index([userId])
}

/// Convite por e-mail para entrar em um grupo.
model HouseholdInvite {
  id          String     @id @default(cuid())
  householdId String
  email       String
  role        MemberRole @default(MEMBER)
  token       String     @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([email])
}

// ─────────────────────── Contas e cartões ───────────────────────

model Account {
  id                  String      @id @default(cuid())
  householdId         String
  name                String
  type                AccountType @default(CHECKING)
  institution         String? /// banco/corretora
  initialBalanceCents Int         @default(0) /// pode ser negativo (ex.: conta no cheque especial)
  color               String      @default("#64748b")
  includeInTotals     Boolean     @default(true) /// soma no saldo geral?
  ownerId             String? /// de quem é a conta (opcional; null = conjunta)
  archivedAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner     User?     @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  transactions        Transaction[]       @relation("TxAccount")
  incomingTransfers   Transaction[]       @relation("TxDestination")
  cardsPaidFromHere   CreditCard[]
  recurrences         Recurrence[]        @relation("RecAccount")
  recurrenceTransfers Recurrence[]        @relation("RecDestination")
  installmentPlans    InstallmentPlan[]
  goals               Goal[]
  balanceCheckpoints  BalanceCheckpoint[]
  loansReceived       Loan[]              @relation("LoanReceivedAccount")
  loansPaidFromHere   Loan[]              @relation("LoanPaymentAccount")

  @@index([householdId])
}

model CreditCard {
  id               String    @id @default(cuid())
  householdId      String
  name             String
  brand            String? /// Visa, Mastercard...
  limitCents       Int       @default(0)
  closingDay       Int /// dia do mês em que a fatura fecha (1–31)
  dueDay           Int /// dia do mês do vencimento (1–31)
  paymentAccountId String? /// conta padrão para pagar a fatura
  holderId         String? /// titular
  color            String    @default("#334155")
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paymentAccount Account?  @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  holder         User?     @relation("CardHolder", fields: [holderId], references: [id], onDelete: SetNull)

  invoices         CreditCardInvoice[]
  transactions     Transaction[]
  installmentPlans InstallmentPlan[]
  recurrences      Recurrence[]

  @@index([householdId])
}

/// Fatura mensal de um cartão. Criada sob demanda quando o primeiro lançamento cai nela.
/// As datas ficam gravadas porque o banco pode mudar o fechamento de um mês para outro.
model CreditCardInvoice {
  id             String        @id @default(cuid())
  creditCardId   String
  referenceMonth DateTime      @db.Date /// dia 1 do mês da fatura (mês do vencimento)
  closingDate    DateTime      @db.Date
  dueDate        DateTime      @db.Date
  status         InvoiceStatus @default(OPEN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  /// compras/estornos da fatura E pagamentos dela (type = INVOICE_PAYMENT)
  transactions Transaction[]

  @@unique([creditCardId, referenceMonth])
}

// ─────────────────────── Categorias ───────────────────────

model Category {
  id          String       @id @default(cuid())
  householdId String
  parentId    String? /// subcategoria de...
  name        String
  type        CategoryType
  color       String       @default("#64748b")
  icon        String?
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent    Category?  @relation("Subcategories", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("Subcategories")

  transactions     Transaction[]
  installmentPlans InstallmentPlan[]
  recurrences      Recurrence[]
  budgets          Budget[]

  @@index([householdId])
  @@index([parentId])
}

// ─────────────────────── Lançamentos ───────────────────────

/// Toda movimentação de dinheiro. Regras por tipo (garantidas por CHECK no banco):
/// - INCOME/EXPENSE:   exatamente um entre accountId e creditCardId; no cartão, invoiceId obrigatório
/// - TRANSFER:         accountId (origem) + destinationAccountId (destino), diferentes
/// - INVOICE_PAYMENT:  accountId (de onde sai) + invoiceId (fatura paga)
model Transaction {
  id          String            @id @default(cuid())
  householdId String
  type        TransactionType
  status      TransactionStatus @default(PAID)
  description String
  amountCents Int /// sempre > 0
  date        DateTime          @db.Date /// data da compra/recebimento (ou vencimento, se pendente)
  notes       String?

  accountId            String?
  destinationAccountId String?
  creditCardId         String?
  invoiceId            String?
  categoryId           String?

  installmentPlanId   String?
  installmentNumber   Int? /// 1..installmentCount
  recurrenceId        String?
  /// Data programada da ocorrência na recorrência (não muda se o pagamento for em outro dia)
  occurrenceDate      DateTime? @db.Date
  /// Valor previsto quando foi gerado pela recorrência; amountCents guarda o valor real após a confirmação
  expectedAmountCents Int?
  goalId              String? /// aporte/resgate de uma meta

  loanId                String?
  /// número da parcela prevista do empréstimo; null = pagamento avulso/antecipado
  loanInstallmentNumber Int?
  /// divisão do pagamento: amortização + juros = amountCents. A amortização pode ser negativa
  /// (pagamento menor que os juros do período, que então se somam ao saldo).
  loanPrincipalCents    Int?
  loanInterestCents     Int?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Quando o lançamento passou a PAID (preenchido pelo banco). Usado pela regra do ajuste
  /// de saldo: no dia do ajuste, só conta o que foi efetivado depois dele.
  paidAt      DateTime?

  household          Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account            Account?           @relation("TxAccount", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccount Account?           @relation("TxDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  creditCard         CreditCard?        @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  invoice            CreditCardInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  category           Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  installmentPlan    InstallmentPlan?   @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)
  recurrence         Recurrence?        @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  goal               Goal?              @relation(fields: [goalId], references: [id], onDelete: SetNull)
  loan               Loan?              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdBy          User?              @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  balanceCheckpoint  BalanceCheckpoint?

  @@unique([installmentPlanId, installmentNumber])
  @@unique([loanId, loanInstallmentNumber])
  @@unique([recurrenceId, occurrenceDate]) /// impede gerar a mesma ocorrência duas vezes
  @@index([householdId, date])
  @@index([householdId, status, date]) /// "previstos para hoje / atrasados"
  @@index([accountId, date])
  @@index([destinationAccountId])
  @@index([invoiceId])
  @@index([categoryId])
}

/// Compra parcelada. As parcelas são lançamentos com installmentPlanId + installmentNumber.
model InstallmentPlan {
  id               String   @id @default(cuid())
  householdId      String
  description      String
  totalAmountCents Int
  installmentCount Int
  firstDate        DateTime @db.Date
  accountId        String?
  creditCardId     String?
  categoryId       String?
  createdAt        DateTime @default(now())

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  creditCard   CreditCard?   @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([householdId])
}

/// Modelo de lançamento fixo (aluguel, salário, assinatura), em conta ou no cartão.
/// A API gera os lançamentos até um horizonte (ex.: 3 meses à frente) e avança nextDate.
/// Fluxo: ocorrência gerada como PENDING com o valor previsto → no dia, o usuário confirma
/// (status PAID), podendo corrigir valor e data; o previsto fica em expectedAmountCents.
model Recurrence {
  id                   String          @id @default(cuid())
  householdId          String
  type                 TransactionType
  description          String
  amountCents          Int
  frequency            Frequency       @default(MONTHLY)
  interval             Int             @default(1) /// a cada N períodos
  startDate            DateTime        @db.Date
  endDate              DateTime?       @db.Date
  nextDate             DateTime        @db.Date /// próxima ocorrência ainda não gerada
  accountId            String?
  destinationAccountId String?
  creditCardId         String?
  categoryId           String?
  amountIsEstimate     Boolean         @default(false) /// valor é só previsão (ex.: energia); pedir o valor real ao confirmar
  autoMarkPaid         Boolean         @default(false) /// gerar já como PAID (ex.: assinatura de valor fixo); não combina com estimativa
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  household          Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account            Account?      @relation("RecAccount", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccount Account?      @relation("RecDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  creditCard         CreditCard?   @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  category           Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions       Transaction[]

  @@index([householdId, active, nextDate])
}

// ─────────────────────── Planejamento ───────────────────────

/// Planejamento do mês: quanto o grupo quer guardar. O "disponível para gastar" é calculado:
/// receitas previstas − compromissos (fixas, parcelas, empréstimos, previstas) − savingsGoalCents.
model MonthPlan {
  id               String   @id @default(cuid())
  householdId      String
  month            DateTime @db.Date /// dia 1 do mês
  savingsGoalCents Int      @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, month])
}

/// Limite de gasto do dia a dia de uma categoria principal em um mês (parte do planejamento).
model Budget {
  id          String   @id @default(cuid())
  householdId String
  categoryId  String
  month       DateTime @db.Date /// dia 1 do mês
  limitCents  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
  @@index([householdId, month])
}

/// Objetivo de economia. Progresso = initialCents + aportes (lançamentos com goalId).
model Goal {
  id           String    @id @default(cuid())
  householdId  String
  name         String
  targetCents  Int
  initialCents Int       @default(0)
  targetDate   DateTime? @db.Date
  accountId    String? /// conta onde o dinheiro da meta fica guardado
  color        String    @default("#0f766e")
  icon         String?
  achievedAt   DateTime?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([householdId])
}

// ─────────────────────── Ajuste de saldo ───────────────────────

/// Marco de saldo de uma conta: "em `date`, o saldo real era `balanceCents`".
/// O saldo passa a partir daqui; lançamentos com data anterior (ou do mesmo dia, mas
/// registrados antes do ajuste) ficam só no histórico e não mudam o saldo.
/// O lançamento de ajuste (ADJUSTMENT_IN/OUT) registra a diferença encontrada.
model BalanceCheckpoint {
  id            String   @id @default(cuid())
  accountId     String
  date          DateTime @db.Date
  balanceCents  Int
  transactionId String?  @unique /// lançamento do ajuste (null quando a diferença era zero)
  createdAt     DateTime @default(now())

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
}

// ─────────────────────── Empréstimos ───────────────────────

/// Empréstimo que o usuário pegou. O saldo devedor é calculado a partir dos pagamentos
/// (lançamentos LOAN_PAYMENT com loanId). Parcelas previstas são lançamentos PENDING com
/// loanInstallmentNumber, que aparecem nos avisos do dia e são confirmados como as recorrências.
model Loan {
  id                String           @id @default(cuid())
  householdId       String
  name              String /// ex.: "Consignado Banco X", "Empréstimo do tio"
  lender            String? /// credor
  principalCents    Int /// valor emprestado
  interestType      LoanInterestType @default(NONE)
  /// taxa mensal como fração (1,99% a.m. = 0.019900); null/0 quando sem juros
  monthlyRate       Decimal?         @db.Decimal(9, 6)
  installmentCount  Int? /// obrigatório na Price; opcional nos outros (plano de pagamento)
  startDate         DateTime         @db.Date /// data em que o dinheiro foi recebido
  firstDueDate      DateTime?        @db.Date /// vencimento da 1ª parcela (se houver plano)
  receivedAccountId String? /// conta onde o dinheiro entrou (null = pago direto a terceiros, ex.: financiamento)
  paymentAccountId  String? /// conta padrão dos pagamentos
  status            LoanStatus       @default(ACTIVE)
  paidOffAt         DateTime?        @db.Date
  color             String           @default("#b45309")
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  household       Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  receivedAccount Account?      @relation("LoanReceivedAccount", fields: [receivedAccountId], references: [id], onDelete: SetNull)
  paymentAccount  Account?      @relation("LoanPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  transactions    Transaction[]

  @@index([householdId, status])
}

// ─────────────────────── Notificações ───────────────────────

/// Aparelho (navegador/PWA) inscrito para receber Web Push.
/// Dados vêm de PushManager.subscribe() no navegador.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String? /// para mostrar "iPhone", "Chrome no PC" na lista de aparelhos
  failureCount  Int       @default(0) /// envios seguidos com erro; removida se o serviço disser que expirou
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Preferências de aviso de cada usuário. Ausente = padrões (ligado, 8h, America/Sao_Paulo).
model NotificationSettings {
  userId          String   @id
  dueItemsEnabled Boolean  @default(true)
  includeOverdue  Boolean  @default(true) /// incluir atrasados no aviso
  sendHour        Int      @default(8) /// hora local do aviso (0–23)
  timezone        String   @default("America/Sao_Paulo") /// IANA
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Um registro por aviso enviado; a unicidade impede avisar duas vezes no mesmo dia.
model NotificationLog {
  id               String           @id @default(cuid())
  userId           String
  kind             NotificationKind
  referenceDate    DateTime         @db.Date /// "hoje" no fuso do usuário
  transactionCount Int
  devicesReached   Int
  sentAt           DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, referenceDate])
}
